rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        request.auth.token.email == 'ceo.developer.appsem@gmail.com' &&
        request.auth.token.email_verified == true;
    }
    function isPublished() { return resource.data.status == 'published'; }

    match /{section}/{id} {
      allow read: if section in ['stories','plans','videos','albums','verses','prayers','homeSections'] &&
        (isPublished() || isAdmin());
      allow create, update, delete: if section in ['stories','plans','videos','albums','verses','prayers','homeSections'] && isAdmin();
    }

    match /storyReactions/{storyId} {
      allow read: if true;
      // Los contadores no se escriben desde el navegador: se calculan desde los documentos.
      allow write: if isAdmin();

      match /likes/{userId} {
        allow read: if true;
        allow create: if signedIn() && request.auth.uid == userId &&
          request.resource.data.keys().hasOnly(['uid','createdAt']) &&
          request.resource.data.uid == userId &&
          request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() &&
          request.resource.data.keys().hasOnly(['uid','text','displayName','photoURL','createdAt','createdAtMs']) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 1500 &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() <= 100 &&
          request.resource.data.photoURL is string &&
          request.resource.data.photoURL.size() <= 2048 &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.createdAtMs is int;
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
        allow update: if false;
      }
    }
  }
}
